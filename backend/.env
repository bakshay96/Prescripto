# Prescripto Backend Environment Variables

PROJECT_NAME="Prescripto - Doctor Prescription & Pharmacy Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Token Config
SECRET_KEY="prescripto_super_secret_jwt_key_2026_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite Default, configurable for PostgreSQL)
DATABASE_URL="sqlite:///./prescripto.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prescripto_db"

# MongoDB Config (ODM Alternative)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="prescripto_db"

# Server Host & Port
HOST="127.0.0.1"
PORT=8080
